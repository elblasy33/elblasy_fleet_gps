<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="elblasy_fleet_gps.Playback">
        <div class="o_gps_map o_gps_pb" t-ref="this.rootRef">
            <div class="o_gps_pb_bar">
                <h1 class="o_gps_pb_title">Playback</h1>
                <select class="o_gps_select" t-on-change="this.onDevice">
                    <option t-foreach="this.state.devices" t-as="dv" t-key="dv.id" t-att-value="dv.id" t-att-selected="dv.id === this.state.deviceId" t-out="dv.name"/>
                </select>
                <div class="o_gps_pb_day">
                    <button class="o_gps_icon_btn" title="Previous day" t-on-click="() => this.shiftDay(-1)"><i class="oi" data-icon="chevron_left"/></button>
                    <input type="date" class="o_gps_select" t-att-value="this.state.day" t-on-change="this.onDay"/>
                    <button class="o_gps_icon_btn" title="Next day" t-on-click="() => this.shiftDay(1)"><i class="oi" data-icon="chevron_right"/></button>
                </div>
                <select class="o_gps_select" t-on-change="this.onTrip" t-if="this.state.data and this.state.data.trips.length">
                    <option value="-1">Whole day</option>
                    <option t-foreach="this.state.data.trips" t-as="tr" t-key="tr_index" t-att-value="tr_index" t-att-selected="tr_index === this.state.tripIdx" t-out="this.fmtTrip(tr)"/>
                </select>
                <span t-if="this.state.data and this.state.data.source === 'traccar'" class="o_gps_badge_note" title="Not stored in Odoo: read from Traccar for this playback">from Traccar</span>
            </div>

            <div class="o_gps_stage">
                <div class="o_gps_canvas" t-ref="this.mapRef"/>
                <div t-if="this.state.noGl" class="o_gps_nogl"><i class="oi" data-icon="warning"/><span>This browser cannot draw the map (WebGL is unavailable).</span></div>
                <div t-if="this.state.error" class="o_gps_pb_msg o_gps_pb_err" t-out="this.state.error"/>
                <div t-elif="!this.state.loading and this.state.data and !this.state.data.pts.length" class="o_gps_pb_msg">
                    <i class="oi" data-icon="location_on"/>
                    <span>No positions for this vehicle on this day.</span>
                </div>
                <div class="o_gps_legend d-none d-md-flex o_gps_pb_legend">
                    <span t-foreach="this.legend" t-as="l" t-key="l.l"><i t-att-style="'background:' + l.c"/><t t-out="l.l"/></span>
                    <small>km/h</small>
                </div>
                <div class="o_gps_pb_panel" t-att-class="{ o_gps_mini: this.state.mini }">
                    <div class="o_gps_pb_ctrl">
                        <button class="o_gps_pb_play" t-on-click="this.toggle" t-att-title="this.state.playing ? 'Pause' : 'Play'">
                            <i class="oi" t-att-data-icon="this.state.playing ? 'pause' : 'play_arrow'"/>
                        </button>
                        <input class="o_gps_pb_slider" type="range" t-att-min="this.state.range[0]" t-att-max="this.state.range[1]" step="1000"
                               t-att-value="this.state.t" t-on-input="this.onSlider"/>
                        <span class="o_gps_pb_time" t-out="this.fmtTime(this.state.t)"/>
                        <button class="o_gps_icon_btn o_gps_pb_fold" t-on-click="this.toggleMini" t-att-title="this.state.mini ? 'Show controls' : 'Hide controls'">
                            <i class="oi" t-att-data-icon="this.state.mini ? 'keyboard_arrow_up' : 'keyboard_arrow_down'"/>
                        </button>
                    </div>
                    <div class="o_gps_pb_row" t-if="!this.state.mini">
                        <button class="o_gps_icon_btn" title="Back 5 min" t-on-click="() => this.jump(-300)"><i class="oi" data-icon="fast_rewind"/></button>
                        <button class="o_gps_icon_btn" title="Forward 5 min" t-on-click="() => this.jump(300)"><i class="oi" data-icon="fast_forward"/></button>
                        <select class="o_gps_select o_gps_pb_speed" t-on-change="this.onSpeed" title="Playback speed">
                            <option t-foreach="this.speeds" t-as="m" t-key="m" t-att-value="m" t-att-selected="this.state.mult === m"><t t-out="m"/>×</option>
                        </select>
                        <span class="o_gps_pb_stat"><b t-out="this.cursorInfo.kmh"/> <small>km/h</small></span>
                        <span class="o_gps_pb_stat"><b t-out="this.cursorInfo.km"/><small>/<t t-out="this.totalKm"/> km</small></span>
                        <span class="o_gps_pb_stat"><i class="oi" data-icon="key"/> <b t-out="this.cursorInfo.ign ? 'ON' : 'OFF'"/></span>
                        <span class="o_gps_pb_spacer"/>
                        <button class="o_gps_icon_btn" t-att-class="{ on: this.state.follow }" title="Follow" t-on-click="this.toggleFollow"><i class="oi" data-icon="my_location"/></button>
                        <button class="o_gps_icon_btn" t-att-class="{ on: this.state.showChart }" title="Speed chart" t-on-click="this.toggleChart"><i class="oi" data-icon="show_chart"/></button>
                        <button class="o_gps_icon_btn" title="Full screen" t-on-click="this.toggleFullscreen"><i class="oi" data-icon="fullscreen"/></button>
                    </div>
                </div>
            </div>
            <div class="o_gps_pb_chart" t-if="this.state.showChart"><canvas t-ref="this.chartRef"/></div>
        </div>
    </t>
</templates>
