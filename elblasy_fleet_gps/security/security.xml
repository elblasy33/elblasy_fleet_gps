<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_fleet_gps" model="res.groups.privilege">
        <field name="name">Fleet GPS</field>
        <field name="sequence">18</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>
    <record id="group_gps_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_fleet_gps"/>
        <field name="implied_ids" eval="[(4, ref('fleet.fleet_group_user'))]"/>
    </record>
    <record id="group_gps_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_fleet_gps"/>
        <field name="implied_ids" eval="[(4, ref('group_gps_user')), (4, ref('fleet.fleet_group_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
